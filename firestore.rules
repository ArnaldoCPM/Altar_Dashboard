rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Indica si la petición proviene de un usuario autenticado.
     */
    function signedIn() {
      return request.auth != null;
    }

    /**
     * Permite identificar el documento canónico y el documento legacy del
     * usuario autenticado. Estos helpers aíslan el flujo temporal de
     * migración y podrán reutilizarse cuando se incorpore authorizedUsers.
     */
    function hasAuthenticatedEmail() {
      return signedIn() && request.auth.token.email != null;
    }

    function isOwnCanonicalUser(userId) {
      return signedIn() && userId == request.auth.uid;
    }

    function isOwnLegacyUser(userId) {
      return hasAuthenticatedEmail() && userId == request.auth.token.email;
    }

    function legacyUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.token.email)
      ).data;
    }

    function legacyUidMatchesCurrentUser() {
      return legacyUser().uid == null
        || legacyUser().uid == ""
        || legacyUser().uid == request.auth.uid;
    }

    /**
     * La creación propia solo está permitida al trasladar un perfil legacy.
     * Todos los campos deben permanecer idénticos salvo uid.
     */
    function canMigrateOwnLegacyUser(userId) {
      return isOwnCanonicalUser(userId)
        && hasAuthenticatedEmail()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.token.email)
        )
        && legacyUidMatchesCurrentUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(legacyUser()).affectedKeys()
          .hasOnly(["uid"]);
    }

    /**
     * El legacy solo se elimina dentro de la misma operación atómica que crea
     * el documento canónico. getAfter valida el estado final del batch.
     */
    function canDeleteOwnLegacyUser(userId) {
      return isOwnLegacyUser(userId)
        && legacyUidMatchesCurrentUser()
        && !exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && existsAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.uid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.diff(resource.data).affectedKeys().hasOnly(["uid"]);
    }

    /**
     * Obtiene el documento de usuario actual desde users/{uid}.
     * Toda la autorización depende de este documento, no del email.
     */
    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /**
     * Indica si el usuario autenticado está activo.
     * Los usuarios inactivos no pueden acceder a colecciones protegidas.
     */
    function isActive() {
      return signedIn() && currentUser().active == true;
    }

    /**
     * Devuelve el rol del usuario autenticado.
     */
    function role() {
      return currentUser().role;
    }

    /**
     * Devuelve la capilla asociada al usuario autenticado.
     */
    function chapelId() {
      return currentUser().chapelId;
    }

    /**
     * Indica si el usuario autenticado es administrador.
     */
    function isAdmin() {
      return isActive() && role() == "admin";
    }

    /**
     * Indica si el usuario autenticado es coordinador.
     */
    function isCoordinator() {
      return isActive() && role() == "coordinator";
    }

    /**
     * Indica si el usuario autenticado es visualizador.
     */
    function isViewer() {
      return isActive() && role() == "viewer";
    }

    /**
     * Verifica si un recurso pertenece a la misma capilla que el usuario actual.
     */
    function sameChapel(resourceData) {
      return resourceData.chapelId == chapelId();
    }

    /**
     * Colección operativa de servidores del altar.
     * La lectura queda abierta a cualquier usuario autenticado y activo.
     * La escritura queda restringida por rol y capilla.
     */
    match /artifacts/{appId}/public/data/servers/{serverId} {
      /**
       * Read:
       * - cualquier usuario autenticado y activo
       */
      allow get, list: if isActive();

      /**
       * Create:
       * - admin
       * - coordinator únicamente cuando el chapelId del documento coincide
       *   con el chapelId del usuario autenticado
       */
      allow create: if isAdmin()
        || (isCoordinator() && sameChapel(request.resource.data));

      /**
       * Update:
       * - admin
       * - coordinator únicamente cuando el documento actual y el documento
       *   resultante permanecen dentro de su misma capilla
       */
      allow update: if isAdmin()
        || (
          isCoordinator()
          && sameChapel(resource.data)
          && sameChapel(request.resource.data)
        );

      /**
       * Delete:
       * - únicamente admin
       */
      allow delete: if isAdmin();
    }

    /**
     * Colección de usuarios del sistema.
     * El modelo objetivo usa users/{uid} como fuente de verdad.
     */
    match /users/{userId} {
      /**
       * Read:
       * - admin puede leer todos
       * - el usuario autenticado puede leer su canónico y su legacy temporal
       */
      allow get: if isOwnCanonicalUser(userId)
        || isOwnLegacyUser(userId)
        || isAdmin();
      allow list: if isAdmin();

      /**
       * Write:
       * - admin conserva acceso total
       * - el usuario solo puede crear su canónico desde su legacy y borrar
       *   dicho legacy como parte del mismo traslado atómico
       */
      allow create: if isAdmin() || canMigrateOwnLegacyUser(userId);
      allow update: if isAdmin();
      allow delete: if isAdmin() || canDeleteOwnLegacyUser(userId);
    }

    /**
     * Catálogo de capillas.
     * Cualquier usuario autenticado y activo puede leerlo.
     * Solo admin puede modificarlo.
     */
    match /chapels/{chapelIdDoc} {
      /**
       * Read:
       * - cualquier usuario autenticado y activo
       */
      allow get, list: if isActive();

      /**
       * Write:
       * - únicamente admin
       */
      allow create, update, delete: if isAdmin();
    }

    /**
     * Formações: leitura para usuários ativos e gestão inicial exclusiva de
     * administradores. A gestão contextual de coordenadores será adicionada
     * quando os polos existirem.
     */
    match /formations/{formationId} {
      function hasValidFormationFields(data) {
        return data.keys().hasOnly([
          "name", "description", "stage", "modalities", "startDate", "endDate",
          "status", "createdBy", "createdAt", "updatedAt"
        ])
          && data.keys().hasAll([
            "name", "stage", "modalities", "status", "createdBy", "createdAt", "updatedAt"
          ])
          && data.name is string
          && data.name.size() > 0
          && data.stage in ["first", "second"]
          && data.modalities is list
          && data.modalities.size() > 0
          && data.modalities.size() <= 2
          && data.modalities.hasOnly(["initial", "permanent"])
          && data.status in ["draft", "active", "completed", "archived"]
          && (!data.keys().hasAny(["description"]) || data.description is string)
          && (!data.keys().hasAny(["startDate"]) || data.startDate is timestamp)
          && (!data.keys().hasAny(["endDate"]) || data.endDate is timestamp)
          && (!data.keys().hasAll(["startDate", "endDate"]) || data.endDate >= data.startDate);
      }

      function hasValidStatusTransition(currentStatus, nextStatus) {
        return currentStatus == nextStatus
          || (currentStatus == "draft" && nextStatus in ["active", "archived"])
          || (currentStatus == "active" && nextStatus in ["completed", "archived"])
          || (currentStatus == "completed" && nextStatus == "archived")
          || (currentStatus == "archived" && nextStatus == "archived");
      }

      allow get, list: if isActive();
      allow create: if isAdmin()
        && hasValidFormationFields(request.resource.data)
        && request.resource.data.status == "draft"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && hasValidFormationFields(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && hasValidStatusTransition(resource.data.status, request.resource.data.status);
    }
  }
}
