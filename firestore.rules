rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Indica si la petición proviene de un usuario autenticado.
     */
    function signedIn() {
      return request.auth != null;
    }

    /**
     * Permite identificar el documento canónico y el documento legacy del
     * usuario autenticado. Estos helpers aíslan el flujo temporal de
     * migración y podrán reutilizarse cuando se incorpore authorizedUsers.
     */
    function hasAuthenticatedEmail() {
      return signedIn() && request.auth.token.email != null;
    }

    function isOwnCanonicalUser(userId) {
      return signedIn() && userId == request.auth.uid;
    }

    function isOwnLegacyUser(userId) {
      return hasAuthenticatedEmail() && userId == request.auth.token.email;
    }

    function legacyUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.token.email)
      ).data;
    }

    function legacyUidMatchesCurrentUser() {
      return legacyUser().uid == null
        || legacyUser().uid == ""
        || legacyUser().uid == request.auth.uid;
    }

    /**
     * La creación propia solo está permitida al trasladar un perfil legacy.
     * Todos los campos deben permanecer idénticos salvo uid.
     */
    function canMigrateOwnLegacyUser(userId) {
      return isOwnCanonicalUser(userId)
        && hasAuthenticatedEmail()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.token.email)
        )
        && legacyUidMatchesCurrentUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(legacyUser()).affectedKeys()
          .hasOnly(["uid"]);
    }

    /**
     * El legacy solo se elimina dentro de la misma operación atómica que crea
     * el documento canónico. getAfter valida el estado final del batch.
     */
    function canDeleteOwnLegacyUser(userId) {
      return isOwnLegacyUser(userId)
        && legacyUidMatchesCurrentUser()
        && !exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && existsAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.uid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.diff(resource.data).affectedKeys().hasOnly(["uid"]);
    }

    /**
     * Obtiene el documento de usuario actual desde users/{uid}.
     * Toda la autorización depende de este documento, no del email.
     */
    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /**
     * Indica si el usuario autenticado está activo.
     * Los usuarios inactivos no pueden acceder a colecciones protegidas.
     */
    function isActive() {
      return signedIn() && currentUser().active == true;
    }

    /**
     * Devuelve el rol del usuario autenticado.
     */
    function role() {
      return currentUser().role;
    }

    /**
     * Devuelve la capilla asociada al usuario autenticado.
     */
    function chapelId() {
      return currentUser().chapelId;
    }

    /**
     * Indica si el usuario autenticado es administrador.
     */
    function isAdmin() {
      return isActive() && role() == "admin";
    }

    /**
     * Indica si el usuario autenticado es coordinador.
     */
    function isCoordinator() {
      return isActive() && role() == "coordinator";
    }

    /**
     * Indica si el usuario autenticado es visualizador.
     */
    function isViewer() {
      return isActive() && role() == "viewer";
    }

    /**
     * Verifica si un recurso pertenece a la misma capilla que el usuario actual.
     */
    function sameChapel(resourceData) {
      return resourceData.chapelId == chapelId();
    }

    /**
     * Colección operativa de servidores del altar.
     * La lectura queda abierta a cualquier usuario autenticado y activo.
     * La escritura queda restringida por rol y capilla.
     */
    match /artifacts/{appId}/public/data/servers/{serverId} {
      /**
       * Read:
       * - cualquier usuario autenticado y activo
       */
      allow get, list: if isActive();

      /**
       * Create:
       * - admin
       * - coordinator únicamente cuando el chapelId del documento coincide
       *   con el chapelId del usuario autenticado
       */
      allow create: if isAdmin()
        || (isCoordinator() && sameChapel(request.resource.data));

      /**
       * Update:
       * - admin
       * - coordinator únicamente cuando el documento actual y el documento
       *   resultante permanecen dentro de su misma capilla
       */
      allow update: if isAdmin()
        || (
          isCoordinator()
          && sameChapel(resource.data)
          && sameChapel(request.resource.data)
        );

      /**
       * Delete:
       * - únicamente admin
       */
      allow delete: if isAdmin();
    }

    /**
     * Colección de usuarios del sistema.
     * El modelo objetivo usa users/{uid} como fuente de verdad.
     */
    match /users/{userId} {
      /**
       * Read:
       * - admin puede leer todos
       * - el usuario autenticado puede leer su canónico y su legacy temporal
       */
      allow get: if isOwnCanonicalUser(userId)
        || isOwnLegacyUser(userId)
        || isAdmin();
      allow list: if isAdmin();

      /**
       * Write:
       * - admin conserva acceso total
       * - el usuario solo puede crear su canónico desde su legacy y borrar
       *   dicho legacy como parte del mismo traslado atómico
       */
      allow create: if isAdmin() || canMigrateOwnLegacyUser(userId);
      allow update: if isAdmin();
      allow delete: if isAdmin() || canDeleteOwnLegacyUser(userId);
    }

    /**
     * Catálogo de capillas.
     * Cualquier usuario autenticado y activo puede leerlo.
     * Solo admin puede modificarlo.
     */
    match /chapels/{chapelIdDoc} {
      /**
       * Read:
       * - cualquier usuario autenticado y activo
       */
      allow get, list: if isActive();

      /**
       * Write:
       * - únicamente admin
       */
      allow create, update, delete: if isAdmin();
    }

    /**
     * Formações: leitura para usuários ativos e gestão inicial exclusiva de
     * administradores. A gestão contextual de coordenadores será adicionada
     * quando os polos existirem.
     */
    match /formations/{formationId} {
      function hasValidFormationFields(data) {
        return data.keys().hasOnly([
          "name", "description", "stage", "modalities", "startDate", "endDate",
          "status", "createdBy", "createdAt", "updatedAt"
        ])
          && data.keys().hasAll([
            "name", "stage", "modalities", "status", "createdBy", "createdAt", "updatedAt"
          ])
          && data.name is string
          && data.name.size() > 0
          && data.stage in ["first", "second"]
          && data.modalities is list
          && data.modalities.size() > 0
          && data.modalities.size() <= 2
          && data.modalities.hasOnly(["initial", "permanent"])
          && data.status in ["draft", "active", "completed", "archived"]
          && (!data.keys().hasAny(["description"]) || data.description is string)
          && (!data.keys().hasAny(["startDate"]) || data.startDate is timestamp)
          && (!data.keys().hasAny(["endDate"]) || data.endDate is timestamp)
          && (!data.keys().hasAll(["startDate", "endDate"]) || data.endDate >= data.startDate);
      }

      function hasValidStatusTransition(currentStatus, nextStatus) {
        return currentStatus == nextStatus
          || (currentStatus == "draft" && nextStatus in ["active", "archived"])
          || (currentStatus == "active" && nextStatus in ["completed", "archived"])
          || (currentStatus == "completed" && nextStatus == "archived")
          || (currentStatus == "archived" && nextStatus == "archived");
      }

      allow get, list: if isActive();
      allow create: if isAdmin()
        && hasValidFormationFields(request.resource.data)
        && request.resource.data.status == "draft"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && hasValidFormationFields(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && hasValidStatusTransition(resource.data.status, request.resource.data.status);

      match /poles/{poleId} {
        function formationExists() {
          return exists(/databases/$(database)/documents/formations/$(formationId));
        }

        function hasValidPoleFields(data) {
          return data.keys().hasOnly([
            "name", "baseChapelId", "chapelIds", "coordinatorIds",
            "active", "createdAt", "updatedAt"
          ])
            && data.keys().hasAll([
              "name", "baseChapelId", "chapelIds", "coordinatorIds",
              "active", "createdAt", "updatedAt"
            ])
            && data.name is string
            && data.name.size() > 0
            && data.baseChapelId is string
            && data.chapelIds is list
            && data.chapelIds.size() > 0
            && data.baseChapelId in data.chapelIds
            && data.coordinatorIds is list
            && data.active is bool
            && data.createdAt is timestamp
            && data.updatedAt is timestamp;
        }

        function isAssignedCoordinator() {
          return isCoordinator()
            && request.auth.uid in resource.data.coordinatorIds;
        }

        function coordinatorChangesOnlyOperationalFields() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["name", "baseChapelId", "chapelIds", "updatedAt"])
            && request.resource.data.coordinatorIds == resource.data.coordinatorIds
            && request.resource.data.active == resource.data.active
            && request.resource.data.createdAt == resource.data.createdAt;
        }

        allow get, list: if isActive() && formationExists();
        allow create: if isAdmin()
          && formationExists()
          && hasValidPoleFields(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if formationExists()
          && hasValidPoleFields(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && (
            isAdmin()
            || (isAssignedCoordinator() && coordinatorChangesOnlyOperationalFields())
          );

        match /encounters/{encounterId} {
          function poleExists() {
            return exists(/databases/$(database)/documents/formations/$(formationId)/poles/$(poleId));
          }

          function poleData() {
            return get(/databases/$(database)/documents/formations/$(formationId)/poles/$(poleId)).data;
          }

          function isPoleCoordinator() {
            return isCoordinator() && request.auth.uid in poleData().coordinatorIds;
          }

          function isEffectiveCoordinator() {
            return isCoordinator() && request.auth.uid in resource.data.coordinatorIds;
          }

          function validEncounter(data) {
            return data.keys().hasOnly(["title", "description", "startAt", "endAt", "location", "status", "coordinatorIds", "responsibilities", "createdBy", "createdAt", "updatedAt"])
              && data.keys().hasAll(["title", "description", "startAt", "location", "status", "coordinatorIds", "responsibilities", "createdBy", "createdAt", "updatedAt"])
              && data.title is string && data.title.size() > 0
              && data.description is string
              && data.startAt is timestamp
              && (!data.keys().hasAny(["endAt"]) || (data.endAt is timestamp && data.endAt >= data.startAt))
              && data.location is map
              && data.location.keys().hasOnly(["chapelId", "name"])
              && data.location.keys().hasAll(["chapelId", "name"])
              && data.location.chapelId is string && data.location.chapelId in poleData().chapelIds
              && data.location.name is string && data.location.name.size() > 0
              && data.status in ["scheduled", "in_progress", "completed", "cancelled"]
              && data.coordinatorIds is list && data.responsibilities is list
              && data.createdBy is string && data.createdAt is timestamp && data.updatedAt is timestamp;
          }

          function validTransition() {
            return resource.data.status == request.resource.data.status
              || (resource.data.status == "scheduled" && request.resource.data.status in ["in_progress", "cancelled"])
              || (resource.data.status == "in_progress" && request.resource.data.status == "completed")
              || (resource.data.status == "completed" && request.resource.data.status == "in_progress");
          }

          function canUpdateScheduledAgenda() {
            return isPoleCoordinator()
              && resource.data.status == "scheduled"
              && request.resource.data.status == "scheduled"
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title", "description", "startAt", "endAt", "location", "updatedAt"]);
          }

          function canManageStatus() {
            return isPoleCoordinator()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
              && ((resource.data.status == "scheduled" && request.resource.data.status in ["in_progress", "cancelled"])
                || (resource.data.status == "in_progress" && request.resource.data.status == "completed"));
          }

          function adminCanUpdate() {
            return isAdmin() && (
              (resource.data.status == "scheduled" && request.resource.data.status in ["scheduled", "in_progress", "cancelled"])
              || (resource.data.status == "in_progress" && request.resource.data.status in ["in_progress", "completed"])
              || (resource.data.status == "completed" && request.resource.data.status == "in_progress")
            );
          }

          function canOperateStatus() {
            return isEffectiveCoordinator()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
              && ((resource.data.status == "scheduled" && request.resource.data.status == "in_progress" && request.resource.data.coordinatorIds.size() > 0)
                || (resource.data.status == "in_progress" && request.resource.data.status == "completed"));
          }

          allow get, list: if isActive() && formationExists() && poleExists();
          allow create: if formationExists() && poleExists() && validEncounter(request.resource.data)
            && (isAdmin() || isPoleCoordinator())
            && request.resource.data.status == "scheduled"
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
          allow update: if formationExists() && poleExists() && validEncounter(request.resource.data)
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time
            && validTransition()
            && (!(resource.data.status == "scheduled" && request.resource.data.status == "in_progress") || request.resource.data.coordinatorIds.size() > 0)
            && (adminCanUpdate() || canUpdateScheduledAgenda() || canManageStatus() || canOperateStatus());

          function canManageParticipants() { return isAdmin() || isPoleCoordinator(); }
          match /participants/{serverId} {
            function validParticipant(data) { return data.keys().hasOnly(["serverId", "serverName", "chapelId", "chapelName", "participationType", "attendanceStatus", "addedManually", "addedBy", "createdAt", "updatedAt"]) && data.keys().hasAll(["serverId", "serverName", "chapelId", "chapelName", "participationType", "attendanceStatus", "addedManually", "addedBy", "createdAt", "updatedAt"]) && data.serverId is string && data.serverId == serverId && data.serverName is string && data.serverName.size() > 0 && data.chapelId is string && data.chapelName is string && data.participationType in ["regular", "manual"] && data.attendanceStatus == "pending" && data.addedManually is bool && data.addedBy == request.auth.uid && data.createdAt is timestamp && data.updatedAt is timestamp; }
            allow get, list: if isActive() && formationExists() && poleExists();
            allow create: if isActive() && formationExists() && poleExists() && validParticipant(request.resource.data) && canManageParticipants() && resource == null && get(/databases/$(database)/documents/formations/$(formationId)/poles/$(poleId)/encounters/$(encounterId)).data.status == "scheduled" && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
            allow delete: if isActive() && formationExists() && poleExists() && canManageParticipants() && get(/databases/$(database)/documents/formations/$(formationId)/poles/$(poleId)/encounters/$(encounterId)).data.status == "scheduled";
          }
          match /participantExclusions/{serverId} {
            function validExclusion(data) { return data.keys().hasOnly(["serverId", "excludedBy", "createdAt"]) && data.keys().hasAll(["serverId", "excludedBy", "createdAt"]) && data.serverId is string && data.serverId == serverId && data.excludedBy == request.auth.uid && data.createdAt is timestamp; }
            allow get, list: if isActive() && formationExists() && poleExists();
            allow create: if isActive() && formationExists() && poleExists() && validExclusion(request.resource.data) && canManageParticipants() && get(/databases/$(database)/documents/formations/$(formationId)/poles/$(poleId)/encounters/$(encounterId)).data.status == "scheduled" && request.resource.data.createdAt == request.time;
            allow delete: if isActive() && formationExists() && poleExists() && canManageParticipants() && get(/databases/$(database)/documents/formations/$(formationId)/poles/$(poleId)/encounters/$(encounterId)).data.status == "scheduled";
          }
        }
      }
    }
  }
}
